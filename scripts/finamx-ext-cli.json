{
  "comment": "Commands and flags of the finamx-ext CLI (@finamx/extension-sdk 2.4.0). scripts/validate.mjs fails when a skill, agent or the README names a command or flag that is not listed here. Keep it equal to the CLI's own flag table when the SDK changes.",
  "sdk": "2.4.0",
  "global": ["--api", "--token", "--json", "--help", "--version"],
  "subcommands": { "domain": ["pull"] },
  "commands": {
    "init": ["--id", "--name", "--target", "--template", "--yes", "--force"],
    "login": ["--token-stdin", "--global"],
    "hosts": ["--manifest"],
    "domain": ["--check"],
    "context": ["--remote"],
    "catalog": ["--page", "--limit"],
    "check": ["--dist", "--manifest", "--config", "--entry", "--host"],
    "serve": ["--dist", "--port", "--manifest", "--ancestor", "--strict-csp"],
    "dev": ["--port", "--no-watch", "--strict-csp", "--open", "--headless", "--no-poll"],
    "publish": ["--manifest", "--dist", "--entry", "--artifact-dir", "--artifact-entry", "--dry-run", "--skip-checks"],
    "status": ["--manifest"],
    "push": ["--manifest", "--dist", "--entry", "--dry-run", "--skip-checks"],
    "link": ["--list"],
    "unlink": []
  }
}
